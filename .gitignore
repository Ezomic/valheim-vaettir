# Build output
bin/
obj/

# Local IDE / user files
*.user
*.suo
.vs/
.idea/

# BepInEx test profile: third-party binaries, not ours to redistribute.
# Recreate by copying the BepInEx tree from any existing profile.
testprofile/

# Renders, not assets. Regenerate with any of:
#   blender --background --python tools/grove_designs.py
#   blender --background --python tools/spirit_core.py
assets/previews/
assets/variants/previews/

# Designs that lost. Kept in git because the reasoning in the scripts is worth
# having, but not shipped - the build copies assets/*.obj beside the dll, and the
# rejected creature bodies alone were 2.6MB of it.
!assets/variants/

# Thunderstore packaging: staging folder and the zips tcli writes.
package/
build/

# Thunderstore packages, rebuilt by own-profile/package.ps1 from the source in this repo.
# A 284K zip in git is a build output, not a source, and it goes stale the moment anything
# under src or assets changes.
dist/

# Python leaves these beside the build scripts and they are pure derivation.
__pycache__/
*.pyc
